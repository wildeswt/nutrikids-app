# PostgreSQL (Docker)
POSTGRES_USER=nutrikids
POSTGRES_PASSWORD=nutrikids
POSTGRES_DB=nutrikids
POSTGRES_PORT=5433

# API (apps/api)
NODE_ENV=development
PORT=3000

# Base de datos local (Docker por defecto)
DATABASE_URL="postgresql://nutrikids:nutrikids@localhost:5433/nutrikids?schema=public"

# Base de datos en Neon (descomentar y configurar para despliegue en Neon):
# - DATABASE_URL (Pooled, host con -pooler): para la API en runtime
# - DIRECT_URL (Direct, sin -pooler): para Prisma CLI / migraciones (evita bloqueos de PgBouncer)
# DATABASE_URL="postgresql://usuario:password@ep-sample-pooler.region.neon.tech/nutrikids?sslmode=require"
# DIRECT_URL="postgresql://usuario:password@ep-sample.region.neon.tech/nutrikids?sslmode=require"

# Mobile (apps/mobile)
# Web / iOS Simulator: http://localhost:3000
# Android Emulator:    http://10.0.2.2:3000
# Dispositivo físico:  http://<TU_IP_LOCAL>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

