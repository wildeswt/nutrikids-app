# PostgreSQL (Docker local default)
POSTGRES_USER=nutrikids
POSTGRES_PASSWORD=nutrikids
POSTGRES_DB=nutrikids
POSTGRES_PORT=5433

# API (apps/api)
NODE_ENV=development
PORT=3000

# Local database (Docker default)
DATABASE_URL="postgresql://nutrikids:nutrikids@localhost:5433/nutrikids?schema=public"

# Neon database (uncomment and configure for Neon deployments):
# - DATABASE_URL (Pooled, host with -pooler): for API runtime
# - DIRECT_URL (Direct, host without -pooler): for Prisma CLI / migrations (bypasses PgBouncer session locks)
# DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/nutrikids?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-sample.region.neon.tech/nutrikids?sslmode=require"

# Mobile (apps/mobile)
# Web / iOS Simulator: http://localhost:3000
# Android Emulator:    http://10.0.2.2:3000
# Physical device:     http://<YOUR_LOCAL_IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
