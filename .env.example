# PostgreSQL (Docker local default)
POSTGRES_USER=nutrikids
POSTGRES_PASSWORD=nutrikids
POSTGRES_DB=nutrikids
POSTGRES_PORT=5433

# API (apps/api)
NODE_ENV=development
PORT=3000

# Auth & Security (NK-09)
# - JWT_ACCESS_SECRET: minimum 32 characters (required in production)
# - PROFESSIONAL_INVITE_CODES: comma-separated invite codes to verify professional registration
JWT_ACCESS_SECRET="nutrikids-dev-test-jwt-secret-key-min-32-chars"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
PROFESSIONAL_INVITE_CODES="NK-PROF-2026"

# Local database (Docker default)
# - DIRECT_URL: Owner connection for Prisma CLI, migrations, fixtures, and CI
# - DATABASE_URL: Application runtime role (nutrikids_app) with restricted privileges and RLS
DIRECT_URL="postgresql://nutrikids:nutrikids@localhost:5433/nutrikids?schema=public"
DATABASE_URL="postgresql://nutrikids_app:nutrikids_app@localhost:5433/nutrikids?schema=public"

# Neon database (uncomment and configure for Neon deployments):
# - DATABASE_URL (Pooled, host with -pooler): for API runtime
# - DIRECT_URL (Direct, host without -pooler): for Prisma CLI / migrations (bypasses PgBouncer session locks)
# DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/nutrikids?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-sample.region.neon.tech/nutrikids?sslmode=require"

# Mobile (apps/mobile)
# Web / iOS Simulator: http://localhost:3000
# Android Emulator:    http://10.0.2.2:3000
# Physical device:     http://<YOUR_LOCAL_IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
