# PostgreSQL (Docker local default)
POSTGRES_USER=nutrikids
POSTGRES_PASSWORD=nutrikids
POSTGRES_DB=nutrikids
POSTGRES_PORT=5433

# API (apps/api)
NODE_ENV=development
PORT=3000
# Allowed origins: * or a comma-separated list (default *)
# CORS_ORIGIN=*

# Auth & Security (NK-09, RT-07)
# - JWT_ACCESS_SECRET: minimum 32 characters (required in production)
# - PROFESSIONAL_INVITE_CODES: comma-separated invite codes to verify professional registration
# - DATA_ENCRYPTION_KEY: 32-byte base64 key for PII at rest (generate with: openssl rand -base64 32)
# - PSEUDONYMIZATION_KEY: 32-byte base64 key for statistical exports (generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET="nutrikids-dev-test-jwt-secret-key-min-32-chars"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOOKUP_MAX_ATTEMPTS=10
LOOKUP_WINDOW_MINUTES=15
PROFESSIONAL_INVITE_CODES="NK-PROF-2026"
DATA_ENCRYPTION_KEY=""
DATA_ENCRYPTION_KEY_ID="k1"
PSEUDONYMIZATION_KEY=""
# - TOTP_ENCRYPTION_KEY: minimum 32 characters (required in production); encrypts professionals'
#   two-factor secrets (NK-10). Do not change it once professionals have enrolled.
TOTP_ENCRYPTION_KEY="nutrikids-dev-test-totp-encryption-key-32+"

# WHO classification cutoffs (RF-08) — optional; z-score thresholds, WHO defaults shown.
# Comparisons are strict (z < cutoff for deficits, z > cutoff for excess).
# CUTOFF_SEVERE_WASTING_WFLH=-3
# CUTOFF_WASTING_WFLH=-2
# CUTOFF_SEVERE_UNDERWEIGHT_WFA=-3
# CUTOFF_UNDERWEIGHT_WFA=-2
# CUTOFF_SEVERE_STUNTING_LHFA=-3
# CUTOFF_STUNTING_LHFA=-2
# CUTOFF_OVERWEIGHT_WFLH=2
# CUTOFF_OVERWEIGHT_BFA=2
# CUTOFF_OVERWEIGHT_RISK_BFA=1
# CUTOFF_OBESITY_BFA=3
# OVERWEIGHT_CRITERION=WFLH   # WFLH | BFA | both

# Alert review deadline (NK-30): hours an alert may stay unreviewed (GENERATED / PENDING_REVIEW)
# before the API flags it `isOverdue`. Overdue alerts are never closed automatically.
ALERT_REVIEW_DEADLINE_HOURS=72
# Severe risk (z < -3); must be <= ALERT_REVIEW_DEADLINE_HOURS
ALERT_REVIEW_DEADLINE_SEVERE_HOURS=24
# How often the overdue-alerts and reminders jobs run, and the minimum hours before notifying
# the same professional again about the same overdue alert (NK-36)
# OVERDUE_ALERTS_INTERVAL_MINUTES=60
# OVERDUE_ALERT_RENOTIFY_HOURS=24

# Days between an erasure request and its execution; the representative can cancel meanwhile (max 14, NK-41)
ERASURE_GRACE_DAYS=7

# Hours before a reminder's date at which caregivers are notified (NK-37)
REMINDER_LEAD_HOURS=24

# Local database (Docker default)
# - DIRECT_URL: Owner connection for Prisma CLI, migrations, fixtures, and CI
# - DATABASE_URL: Application runtime role (nutrikids_app) with restricted privileges and RLS
DIRECT_URL="postgresql://nutrikids:nutrikids@localhost:5433/nutrikids?schema=public"
DATABASE_URL="postgresql://nutrikids_app:nutrikids_app@localhost:5433/nutrikids?schema=public"

# Neon database (uncomment and configure for Neon deployments):
# - DATABASE_URL (Pooled, host with -pooler): for API runtime
# - DIRECT_URL (Direct, host without -pooler): for Prisma CLI / migrations (bypasses PgBouncer session locks)
# DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/nutrikids?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-sample.region.neon.tech/nutrikids?sslmode=require"

# Backups (scripts/backup, NK-44): read from the environment by backup.sh and restore.sh
# BACKUP_PASSPHRASE=change-me-long-random-passphrase
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=30
# DOCKER_CONTAINER=nutrikids-postgres

# Mobile (apps/mobile)
# Web / iOS Simulator: http://localhost:3000
# Android Emulator:    http://10.0.2.2:3000
# Physical device:     http://<YOUR_LOCAL_IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
